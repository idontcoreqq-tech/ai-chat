# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Модель Gemini (можно gemini-2.0-flash, gemini-1.5-flash и др.)
GEMINI_MODEL=gemini-3.8-flash

# При перегрузке Gemini (503) отвечать заготовками из mocks (false — только ошибка)
GEMINI_MOCK_ON_OVERLOAD=true

PORT=3001

# true — только моки на фронте без backend
VITE_USE_MOCK=false
